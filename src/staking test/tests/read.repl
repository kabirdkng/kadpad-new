;; Read-only tests for staking queries
;; This file tests balance threshold queries and eligibility checks

(begin-tx "Read-only staking queries")
(namespace 'STAKE_NS)
(use staking)

;; Helper function to check if account meets threshold
(defun meets-threshold:bool (account:string threshold:decimal)
  (>= (at 'total (staking.get-lockup account)) threshold))

;; Get accounts grouped by tiers using the built-in function
(let ((tier-data (staking.get-accounts-by-tier))
      (all-accounts (staking.get-lockups)))

  ; Extract tier data
  (let ((tier-1-accounts (at 'tier-1 tier-data))
        (tier-2-accounts (at 'tier-2 tier-data))
        (tier-3-accounts (at 'tier-3 tier-data)))

    ; Print staking eligibility report
    (print "\n=== Staking Eligibility Report ===")
    (print (format "Total stakers: {}" [(length all-accounts)]))
    (print (format "Total tokens staked: {}" [(at 'total (staking.get-total-count))]))

    (print "\n--- Tier 1 (50,000 - 149,999 tokens) ---")
    (print (format "Eligible accounts: {}" [(map (at 'account) tier-1-accounts)]))
    (print (format "Count: {}" [(length tier-1-accounts)]))
    (map (lambda (obj) 
      (print (format "  {} - {} tokens" [(at 'account obj) (at 'total obj)]))) 
      tier-1-accounts)

    (print "\n--- Tier 2 (150,000 - 349,999 tokens) ---")
    (print (format "Eligible accounts: {}" [(map (at 'account) tier-2-accounts)]))
    (print (format "Count: {}" [(length tier-2-accounts)]))
    (map (lambda (obj) 
      (print (format "  {} - {} tokens" [(at 'account obj) (at 'total obj)]))) 
      tier-2-accounts)

    (print "\n--- Tier 3 (≥350,000 tokens) ---")
    (print (format "Eligible accounts: {}" [(map (at 'account) tier-3-accounts)]))
    (print (format "Count: {}" [(length tier-3-accounts)]))
    (map (lambda (obj) 
      (print (format "  {} - {} tokens" [(at 'account obj) (at 'total obj)]))) 
      tier-3-accounts)

    ;; Calculate accounts above thresholds for testing (includes higher tiers)
    (let ((above-50000 (+ (+ (length tier-1-accounts) (length tier-2-accounts)) (length tier-3-accounts)))
          (above-150000 (+ (length tier-2-accounts) (length tier-3-accounts)))
          (above-350000 (length tier-3-accounts))
          (tier-1-account-names (map (at 'account) tier-1-accounts))
          (tier-2-account-names (map (at 'account) tier-2-accounts))
          (tier-3-account-names (map (at 'account) tier-3-accounts)))

      ;; Test expectations
      (expect "3 accounts above 50000" 3 above-50000)
      (expect "2 accounts above 150000" 2 above-150000)
      (expect "1 account above 350000" 1 above-350000)

      ;; Check specific accounts using individual tier lists
      (expect "alice is NOT above 50000" false 
        (or (contains "alice" tier-1-account-names)
            (or (contains "alice" tier-2-account-names)
                (contains "alice" tier-3-account-names))))
      (expect "bob is above 150000" true 
        (or (contains "bob" tier-2-account-names)
            (contains "bob" tier-3-account-names)))
      (expect "carol is above 350000" true (contains "carol" tier-3-account-names))
      (expect "dave is above 50000" true 
        (or (contains "dave" tier-1-account-names)
            (or (contains "dave" tier-2-account-names)
                (contains "dave" tier-3-account-names))))
    )))

;; Get detailed info for each tier
(print "\n=== Detailed Staking Information ===")
(map (lambda (account)
  (let ((lockup (staking.get-lockup account)))
    (print (format "Account: {} | Staked: {} | Unlock: {}"
      [account (at 'total lockup) (at 'unlockDate lockup)]))))
  (staking.get-lockups))

(commit-tx)

;; Test queries for individual account eligibility
(begin-tx "Individual eligibility checks")
(namespace 'STAKE_NS)
(use staking)

(defun check-eligibility:object (account:string)
  @doc "Check eligibility for all reward tiers"
  (let ((total (at 'total (staking.get-lockup account))))
    { 'account: account
    , 'total-staked: total
    , 'tier-1-eligible: (>= total 50000.0)
    , 'tier-2-eligible: (>= total 150000.0)
    , 'tier-3-eligible: (>= total 350000.0)
    }))


(expect "Alice not eligible for any tier (40k staked)"
  { 'account: "alice", 'total-staked: 40000.0, 'tier-1-eligible: false, 'tier-2-eligible: false, 'tier-3-eligible: false }
  (check-eligibility "alice"))

(expect "Carol eligible for all tiers"
  { 'account: "carol", 'total-staked: 350000.0, 'tier-1-eligible: true, 'tier-2-eligible: true, 'tier-3-eligible: true }
  (check-eligibility "carol"))

;; Test tier functions with gas tests, expect > 40,000 but it would require many entries to be an issue
(env-gasmodel "table")(env-gaslimit 250000)
(staking.get-tier-data)
(enforce (< (env-gas) 41000) "Gas is below concern level")
(env-gas 0)
(staking.get-accounts-by-tier)
(enforce (< (env-gas) 41000) "Gas is below concern level")
(env-gas 0)
(get-staker-count)
(enforce (< (env-gas) 41000) "Gas is below concern level")

(commit-tx)

