;; Load the environment
(env-data {"disable-marmalade":true,
           "disable-util-lib":false,
           "disable-test-accounts":false})

(load "kda-env/init.repl")
(load "helpers/init.repl")
(load "test-tokens/token1.repl")

;; Load staking module
(begin-tx "Load staking module")
(namespace 'STAKE_NS)
(load "stake.pact")
(create-table token-lock)
(create-table total-tokens)
(typecheck "STAKE_NS.staking")
(commit-tx)

(load "tests/main.repl")