(staking.lock-tokens "alice" (read-keyset "alice") 10000.0)
(expect "Alice now has 60000 locked" 60000.0 (at 'total (staking.get-lockup "alice")))
(expect "Total tokens updated" 60000.0 (at 'total (staking.get-total-count)))
