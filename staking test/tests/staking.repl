;; Security Tests
(begin-tx "Test unauthorized withdrawal - Carol tries to steal Alice's tokens")
(namespace 'STAKE_NS)
(use staking)
(env-chain-data { 'block-time: (time "1971-01-02T00:00:00Z")}) ;; Set time after maturity
(env-sigs [{ 'key: "carol-key", 'caps: [
  (staking.VERIFY-LOCKER "alice"),
  (token1.TRANSFER (staking.get-LOCKER-account "alice") "carol" 100.0)]}])

(expect-failure "Carol cannot withdraw Alice's tokens"
  "Keyset failure"
  (staking.remove-tokens "alice" 100.0))
(commit-tx)

(begin-tx "Test withdrawal with heavy penalty (day 1)")
(namespace 'STAKE_NS)
(use staking)
(env-sigs [{ 'key: "alice-key", 'caps: [
  (staking.VERIFY-LOCKER "alice")]}])
(env-chain-data { 'block-time: (time "1970-01-02T00:00:00Z")}) ;; Day 1

;; Withdraw on day 1 should work but with ~99.73% penalty
(let ((alice-before (token1.get-balance "alice"))
      (burn-before (token1.get-balance BURN_NS.burn.BURN-ACCOUNT)))
  (staking.remove-tokens "alice" 10000.0)
  (let ((alice-after (token1.get-balance "alice"))
        (burn-after (token1.get-balance BURN_NS.burn.BURN-ACCOUNT)))
    ;; Alice should get only ~0.27% of 10000 = ~27 tokens
    (expect "Alice received minimal tokens due to penalty" true 
      (< (- alice-after alice-before) 50.0))
    ;; Treasury should get ~99.73% of 10000 = ~9973 tokens
    (expect "Treasury received most tokens as penalty" true 
      (> (- burn-after burn-before) 9950.0))))
(expect "Alice has 50000 remaining locked" 50000.0 (at 'total (staking.get-lockup "alice")))
(commit-tx)

;; Test successful withdrawal after maturity
(begin-tx "Test withdrawal after maturity")
(namespace 'STAKE_NS)
(use staking)
(env-sigs [{ 'key: "alice-key", 'caps: [
  (staking.VERIFY-LOCKER "alice")
  ]}])
(env-chain-data { 'block-time: (time "1971-01-02T00:00:00Z")})
(print (token1.get-balance "alice"))
(let ((alice-before (token1.get-balance "alice"))
      (burn-before (token1.get-balance BURN_NS.burn.BURN-ACCOUNT)))
  (staking.remove-tokens "alice" 10000.0)
  (let ((alice-after (token1.get-balance "alice"))
        (burn-after (token1.get-balance BURN_NS.burn.BURN-ACCOUNT)))
    ;; After 365 days, no penalty - Alice gets full 10000 back
    (expect "Alice received full amount (no penalty)" 10000.0 (- alice-after alice-before))
    (expect "Treasury received nothing (no penalty)" 0.0 (- burn-after burn-before))))
(expect "Alice withdrew 10000, 40000 remaining" 40000.0 (at 'total (staking.get-lockup "alice")))
(expect "Total tokens updated" 190000.0 (at 'total (staking.get-total-count)))
(commit-tx)

;; Test overdraw prevention
(begin-tx "Test overdraw prevention")
(namespace 'STAKE_NS)
(use staking)
(env-sigs [{ 'key: "alice-key", 'caps: [
  (staking.VERIFY-LOCKER "alice"),
  (token1.TRANSFER (staking.get-LOCKER-account "alice") "alice" 2000.0)]}])
(env-chain-data { 'block-time: (time "1971-01-02T00:00:00Z")})

(expect-failure "Cannot withdraw more than locked"
  "Not enough tokens in lockup"
  (staking.remove-tokens "alice" 50000.0))
(commit-tx)

