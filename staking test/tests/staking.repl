;; Basic Staking Tests
(begin-tx "Test lock tokens - Alice")
(namespace 'STAKE_NS)
(use staking)
(env-data {
  "alice": {
    "keys": ["alice-key"],
    "pred": "keys-all"
  }})
(env-sigs [{ 'key: "alice-key", 'caps: [
  (token1.TRANSFER "alice" (staking.get-LOCKER-account "alice") 50000.0)]}])

(staking.lock-tokens "alice" (read-keyset "alice") 50000.0)
(expect "Alice locked 50000 tokens"
  50000.0
  (at 'total (staking.get-lockup "alice")))
(expect "Total tokens updated" 50000.0 (at 'total (staking.get-total-count)))
(expect "Alice's token1 balance decreased" 50000.0 (token1.get-balance "alice"))
(commit-tx)

(begin-tx "Test lock more tokens - Alice")
(namespace 'STAKE_NS)
(use staking)
(env-data {
  "alice": {
