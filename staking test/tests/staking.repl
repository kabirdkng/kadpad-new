;; Test get all lockup accounts
(begin-tx "Test read functions")
(namespace 'STAKE_NS)
(use staking)
(let ((lockups (staking.get-lockups)))
  (expect "Four accounts have lockups" 4 (length lockups))
  (expect "Alice is in lockups" true (contains "alice" lockups))
  (expect "Bob is in lockups" true (contains "bob" lockups))
  (expect "Carol is in lockups" true (contains "carol" lockups))
  (expect "Dave is in lockups" true (contains "dave" lockups)))
(commit-tx)

