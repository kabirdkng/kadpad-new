; Test token distribution from treasury to operational accounts
; This test validates the initial token distribution setup

(begin-tx)
; Test initial state - all tokens should be in deployer account
(expect "deployer account has full supply" 1.0
  (NS.token.get-balance "deployer-account"))
(commit-tx)

; Test token distribution to operational accounts
(begin-tx)
(env-sigs
  [{ "key": "gk"
   , "caps": 
     [(NS.token.TRANSFER "deployer-account" NS.token-sales.RESERVE-ACCOUNT 0.4)
      (NS.token.TRANSFER "deployer-account" NS.token-treasury.LIQUIDITY-ACCOUNT 0.3)
      (NS.token.TRANSFER "deployer-account" NS.token-treasury.TREASURY-ACCOUNT 0.3)]
   }])

; Transfer tokens to operational accounts
(NS.token.transfer-create 
  "deployer-account" 
  NS.token-sales.RESERVE-ACCOUNT
  NS.token-sales.RESERVE-GUARD
  0.4)

(NS.token.transfer-create 
  "deployer-account" 
  NS.token-treasury.LIQUIDITY-ACCOUNT
  NS.token-treasury.LIQUIDITY-GUARD
  0.3)

(NS.token.transfer-create 
  "deployer-account" 
  NS.token-treasury.TREASURY-ACCOUNT
  NS.token-treasury.TREASURY-GUARD
  0.3)

; Test distribution results
(expect "reserve account received 40% of supply" 0.4
  (NS.token.get-balance NS.token-sales.RESERVE-ACCOUNT))
(expect "liquidity account received 30% of supply" 0.3
  (NS.token.get-balance NS.token-treasury.LIQUIDITY-ACCOUNT))
(expect "treasury operational account received 30% of supply" 0.3
  (NS.token.get-balance NS.token-treasury.TREASURY-ACCOUNT))
(expect "deployer account is empty after distribution" 0.0
  (NS.token.get-balance "deployer-account"))

; Test sales system configuration
(expect "sales reserve matches expected sales tokens" 
  (* NS.token-sales.TOTAL-BATCHES 
     NS.token-sales.AMOUNT-PER-BATCH)
  (NS.token.get-balance NS.token-sales.RESERVE-ACCOUNT))

(print "✅ Token distribution completed successfully")
(commit-tx)
